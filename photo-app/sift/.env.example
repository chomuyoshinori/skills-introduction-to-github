# Immich サーバー(Mac mini 上で稼働しているもの)
IMMICH_URL=http://localhost:2283

# Immich Web → 右上アイコン → Account Settings → API Keys → New API Key で発行
IMMICH_API_KEY=

# 1 にすると Immich なしでダミー写真で動く(開発・お試し用)
SIFT_MOCK=0

# 簡易PINロック(任意)。設定すると初回アクセス時にPIN入力を求める。
# Tailscale外に出さないのが大前提だが、同一LANの他人からの誤操作・いたずら防止に。
# SIFT_PIN=1234

# Sift サーバーの待受ポート
PORT=8787

# SQLite の保存先(既定: server/sift.db)
# SIFT_DB=./sift.db
